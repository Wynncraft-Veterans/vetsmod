{
	"schemaVersion": 1,
	"id": "vetsmod",
	"version": "${version}",
	"name": "vetsmod",
	"description": "A minecraft client modification implementing various quality of life and cosmetic features for members of the VETS wynncraft guild. Also contains general features useful for Wynncraft users -- especially returning players and staff of community guilds -- more generally. !",
	"authors": [
		"Kiwidude1010",
		"Wenweia"
	],
	"contact": {
		"homepage": "https://wynnvets.org/",
		"sources": "https://github.com/Wynncraft-Veterans/vetsmod"
	},
	"license": "MPL-2.0",
	"icon": "assets/vetsmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.wynnvets.Vetsmod"
		],
		"client": [
			"org.wynnvets.VetsmodClient"
		]
	},
	"mixins": [
		"vetsmod.mixins.json",
		{
			"config": "vetsmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*",
		"wynntils": ">=3.4.5 <4.0.0"
	}
}